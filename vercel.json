{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/es/:path*", "destination": "/es/index.html" },
    { "source": "/nl/:path*", "destination": "/nl/index.html" },
    { "source": "/de/:path*", "destination": "/de/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
